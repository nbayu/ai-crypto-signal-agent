#!/usr/bin/env bash
set -euo pipefail

readonly TRUSTED_CP09_COMMIT="e50041f7296bd9e042f749b6a98393b3df9747a1"
readonly TRUSTED_SHA256="64fe567ee269739146c30a9111113a07b1fd91d83d46e9e8dbd7fa967f1cbb6f"
readonly RELEASE_REF="/var/lib/ai-crypto-signal-agent/installed-release.path"
readonly RUNTIME_MARKER="/var/lib/ai-crypto-signal-agent/accepted-locked-commit.marker"
readonly KILL_SWITCH="/var/lib/ai-crypto-signal-agent/kill-switch.active"
readonly LOCK_PATH="/run/ai-crypto-signal-agent/operational.lock"
readonly SERVICE_UNIT="/etc/systemd/system/ai-crypto-signal-agent.service"
readonly TIMER_UNIT="/etc/systemd/system/ai-crypto-signal-agent.timer"
readonly CONTROL_UNIT="/etc/systemd/system/ai-crypto-signal-agent-telegram-control.service"
readonly OWNER_CONTROL_ENV="/etc/ai-crypto-signal-agent/owner-control.env"
readonly OWNER_CONTROL_STATE="/var/lib/ai-crypto-signal-agent/phase09r1/owner-blueprint/telegram-owner-control-state-v1.json"
readonly TELEGRAM_ENV="/etc/ai-crypto-signal-agent/phase09r1.env"
readonly PROVIDER_ENV="/etc/ai-crypto-signal-agent/deepseek.env"
readonly SERVICE_USER="ai-crypto-signal-agent"
readonly SERVICE_GROUP="ai-crypto-signal-agent"

failure_count=0
declare -a failure_reasons=()

record_check() {
    local key="$1"
    local result="$2"
    local reason="$3"
    printf '%s=%s\n' "$key" "$result"
    if [[ "$result" == "YES" || "$result" == "PASS" ]]; then
        return
    fi
    failure_reasons+=("$reason")
    failure_count=$((failure_count + 1))
}

record_failure() {
    failure_reasons+=("$1")
    failure_count=$((failure_count + 1))
}

unit_directive() {
    local path="$1"
    local key="$2"
    sed -n "s/^${key}=//p" "$path"
}

verify_exact_marker() {
    local path="$1"
    [[ -f "$path" && ! -L "$path" ]] &&
        [[ "$(wc -c < "$path")" -eq 41 ]] &&
        [[ "$(sha256sum "$path" | awk '{print $1}')" == "$TRUSTED_SHA256" ]]
}

verify_env_metadata() {
    local path="$1"
    shift
    [[ -f "$path" && ! -L "$path" ]] || return 1
    [[ "$(stat -c '%U:%G:%a' "$path")" == "root:root:600" ]] || return 1
    local key
    for key in "$@"; do
        [[ "$(awk -F= -v key="$key" '$1 == key { count += 1; if (length($0) > length(key) + 1) nonempty += 1 } END { print count ":" nonempty }' "$path")" == "1:1" ]] ||
            return 1
    done
    ! LC_ALL=C grep -q $'\r' "$path"
}

release_root=""
if [[ -f "$RELEASE_REF" && ! -L "$RELEASE_REF" && "$(wc -l < "$RELEASE_REF")" -eq 1 ]]; then
    release_root="$(sed -n '1p' "$RELEASE_REF")"
fi

release_match=NO
remote_head_match=NO
binding_match=NO
marker_match=NO
service_match=NO
timer_match=NO
if [[ -n "$release_root" && -d "$release_root" && ! -L "$release_root" &&
      "$(basename -- "$release_root")" =~ ^[0-9a-f]{40}$ &&
      -f "$release_root/.f4-release-manifest" ]]; then
    manifest_commit="$(sed -n 's/^SOURCE_COMMIT=//p' "$release_root/.f4-release-manifest")"
    if [[ "$manifest_commit" == "$(basename -- "$release_root")" ]]; then
        release_match=YES
        remote_head_match=YES
    fi
    if verify_exact_marker "$release_root/TRUSTED_CP09_COMMIT"; then
        binding_match=YES
    fi
    if [[ -f "$SERVICE_UNIT" && ! -L "$SERVICE_UNIT" &&
          -f "$release_root/.f4-rendered/ai-crypto-signal-agent.service" &&
          "$(sha256sum "$SERVICE_UNIT" | awk '{print $1}')" == "$(sha256sum "$release_root/.f4-rendered/ai-crypto-signal-agent.service" | awk '{print $1}')" ]]; then
        service_match=YES
    fi
    if [[ -f "$TIMER_UNIT" && ! -L "$TIMER_UNIT" &&
          "$(sha256sum "$TIMER_UNIT" | awk '{print $1}')" == "$(sha256sum "$release_root/deploy/operational_v1/systemd/ai-crypto-signal-agent.timer" | awk '{print $1}')" ]]; then
        timer_match=YES
    fi
fi
verify_exact_marker "$RUNTIME_MARKER" && marker_match=YES

service_inactive=NO
service_enabled_valid=NO
service_active_state="$(systemctl is-active ai-crypto-signal-agent.service 2>/dev/null || true)"
service_enabled_state="$(systemctl is-enabled ai-crypto-signal-agent.service 2>/dev/null || true)"
[[ "$service_active_state" == "inactive" ]] && service_inactive=YES
[[ "$service_enabled_state" == "static" || "$service_enabled_state" == "disabled" ]] &&
    service_enabled_valid=YES

control_installed=NO
control_state_valid=NO
owner_authority_valid=NO
control_active_state="$(systemctl is-active ai-crypto-signal-agent-telegram-control.service 2>/dev/null || true)"
control_enabled_state="$(systemctl is-enabled ai-crypto-signal-agent-telegram-control.service 2>/dev/null || true)"
[[ -f "$CONTROL_UNIT" && ! -L "$CONTROL_UNIT" ]] && control_installed=YES
if verify_env_metadata "$OWNER_CONTROL_ENV" TELEGRAM_OWNER_USER_ID TELEGRAM_OWNER_CHAT_ID; then
    owner_authority_valid=YES
fi
if [[ -f "$OWNER_CONTROL_STATE" && ! -L "$OWNER_CONTROL_STATE" &&
      "$(stat -c '%U:%G:%a' "$OWNER_CONTROL_STATE")" == "$SERVICE_USER:$SERVICE_GROUP:600" ]] &&
   grep -q '"schema_name":"telegram-owner-control-state"' "$OWNER_CONTROL_STATE" &&
   grep -q '"schema_version":1' "$OWNER_CONTROL_STATE"; then
    control_state_valid=YES
fi

timer_active_state="$(systemctl is-active ai-crypto-signal-agent.timer 2>/dev/null || true)"
timer_enabled_state="$(systemctl is-enabled ai-crypto-signal-agent.timer 2>/dev/null || true)"
timer_substate="$(systemctl show ai-crypto-signal-agent.timer -p SubState --value 2>/dev/null || true)"
readonly TIMER_DBUS_OBJECT="/org/freedesktop/systemd1/unit/ai_2dcrypto_2dsignal_2dagent_2etimer"
timer_next_monotonic_raw="$(busctl get-property org.freedesktop.systemd1 "$TIMER_DBUS_OBJECT" org.freedesktop.systemd1.Timer NextElapseUSecMonotonic 2>/dev/null || true)"
timer_next_realtime_raw="$(busctl get-property org.freedesktop.systemd1 "$TIMER_DBUS_OBJECT" org.freedesktop.systemd1.Timer NextElapseUSecRealtime 2>/dev/null || true)"
current_monotonic_usec="$(/usr/bin/python3 -c 'import time; print(time.clock_gettime_ns(time.CLOCK_MONOTONIC) // 1000)' 2>/dev/null || true)"

timer_next_monotonic_usec=""
timer_next_realtime_usec=""
remaining_until_elapse_usec=""
timer_next_monotonic_finite=NO
timer_next_monotonic_in_future=NO
timer_next_elapse_scheduled=NO
timer_schedule_failure_reason=TIMER_MONOTONIC_NEXT_ELAPSE_MISSING
if [[ "$timer_next_monotonic_raw" =~ ^t[[:space:]]([0-9]+)$ ]]; then
    timer_next_monotonic_usec="${BASH_REMATCH[1]}"
    if [[ "$timer_next_monotonic_usec" == "0" ||
          "$timer_next_monotonic_usec" == "18446744073709551615" ]]; then
        timer_schedule_failure_reason=TIMER_MONOTONIC_NEXT_ELAPSE_MISSING
    elif [[ ! "$current_monotonic_usec" =~ ^[0-9]+$ ]]; then
        timer_schedule_failure_reason=TIMER_MONOTONIC_NEXT_ELAPSE_MALFORMED
    else
        timer_next_monotonic_finite=YES
        remaining_until_elapse_usec=$((timer_next_monotonic_usec - current_monotonic_usec))
        if [[ "$remaining_until_elapse_usec" -gt 0 ]]; then
            timer_next_monotonic_in_future=YES
            timer_next_elapse_scheduled=YES
            timer_schedule_failure_reason=""
        else
            timer_schedule_failure_reason=TIMER_MONOTONIC_NEXT_ELAPSE_NOT_IN_FUTURE
        fi
    fi
elif [[ -n "$timer_next_monotonic_raw" ]]; then
    timer_schedule_failure_reason=TIMER_MONOTONIC_NEXT_ELAPSE_MALFORMED
fi
if [[ "$timer_next_realtime_raw" =~ ^t[[:space:]]([0-9]+)$ ]]; then
    timer_next_realtime_usec="${BASH_REMATCH[1]}"
fi

timer_persistent_valid=NO
timer_model_valid=NO
timer_interval_valid=NO
timer_target_valid=NO
timer_count_valid=NO
automatic_retry_disabled=NO
trading_execution_disabled=NO
if [[ -f "$TIMER_UNIT" && ! -L "$TIMER_UNIT" ]]; then
    [[ "$(unit_directive "$TIMER_UNIT" Persistent)" == "false" ]] &&
        timer_persistent_valid=YES
    [[ "$(unit_directive "$TIMER_UNIT" OnActiveSec)" == "30min" &&
       "$(unit_directive "$TIMER_UNIT" OnUnitInactiveSec)" == "30min" ]] && {
        timer_model_valid=YES
        timer_interval_valid=YES
    }
    [[ "$(unit_directive "$TIMER_UNIT" Unit)" == "ai-crypto-signal-agent.service" ]] &&
        timer_target_valid=YES
fi
if [[ -n "$release_root" && -d "$release_root/deploy" ]]; then
    [[ "$(find "$release_root/deploy" -type f -name '*.timer' -print | wc -l)" -eq 1 ]] &&
        timer_count_valid=YES
    package_manifest="$release_root/deploy/operational_v1/deployment-package-manifest.txt"
    if [[ -f "$package_manifest" && ! -L "$package_manifest" ]]; then
        [[ "$(sed -n 's/^AUTOMATIC_RETRY=//p' "$package_manifest")" == "disabled" ]] &&
            automatic_retry_disabled=YES
        [[ "$(sed -n 's/^TRADING_EXECUTION=//p' "$package_manifest")" == "disabled" ]] &&
            trading_execution_disabled=YES
    fi
fi

credential_ready=NO
if verify_env_metadata "$TELEGRAM_ENV" TELEGRAM_BOT_TOKEN TELEGRAM_DESTINATION_ID &&
   verify_env_metadata "$PROVIDER_ENV" DEEPSEEK_API_KEY; then
    credential_ready=YES
fi

kill_ready=NO
kill_active=NO
if [[ ! -e "$KILL_SWITCH" && ! -L "$KILL_SWITCH" ]]; then
    kill_ready=YES
elif [[ -f "$KILL_SWITCH" && ! -L "$KILL_SWITCH" ]]; then
    kill_ready=YES
    kill_active=YES
fi

lock_state_valid=YES
lock_residual=NO
if [[ -e "$LOCK_PATH" || -L "$LOCK_PATH" ]]; then
    lock_metadata="$(stat -Lc '%U:%G:%a' "$LOCK_PATH" 2>/dev/null || true)"
    if [[ ! -f "$LOCK_PATH" || -L "$LOCK_PATH" ||
          "$lock_metadata" != "$SERVICE_USER:$SERVICE_GROUP:600" ]]; then
        lock_state_valid=NO
    elif ! { exec 8<"$LOCK_PATH"; } 2>/dev/null; then
        lock_state_valid=NO
    elif ! flock -n 8; then
        lock_residual=YES
    fi
fi

disk_ready=NO
available_kib="$(df -Pk "$(dirname -- "$RUNTIME_MARKER")" | awk 'NR == 2 { print $4 }')"
[[ "$available_kib" =~ ^[0-9]+$ && "$available_kib" -ge 1048576 ]] && disk_ready=YES

record_check F4_REMOTE_HEAD_MATCH "$remote_head_match" RELEASE_IDENTITY_MISMATCH
record_check IMMUTABLE_RELEASE_MATCH "$release_match" RELEASE_IDENTITY_MISMATCH
record_check TRUSTED_CP09_BINDING_MATCH "$binding_match" TRUSTED_CP09_BINDING_MISMATCH
record_check RUNTIME_MARKER_MATCH "$marker_match" RUNTIME_MARKER_MISMATCH
record_check SERVICE_UNIT_MATCH "$service_match" SERVICE_UNIT_IDENTITY_MISMATCH
record_check TIMER_UNIT_MATCH "$timer_match" TIMER_UNIT_IDENTITY_MISMATCH
record_check SERVICE_INACTIVE "$service_inactive" SERVICE_NOT_INACTIVE
record_check SERVICE_ENABLED_VALID "$service_enabled_valid" SERVICE_ENABLEMENT_STATE_MISMATCH
record_check CONTROL_INSTALLED "$control_installed" CONTROL_UNIT_MISSING
record_check CONTROL_STATE_VALID "$control_state_valid" CONTROL_STATE_INVALID
record_check OWNER_AUTHORITY_METADATA_VALID "$owner_authority_valid" OWNER_AUTHORITY_METADATA_INVALID
record_check CREDENTIAL_READINESS "$([[ "$credential_ready" == YES ]] && printf PASS || printf FAIL)" CREDENTIAL_READINESS_FAILED
record_check KILL_SWITCH_READY "$kill_ready" KILL_SWITCH_STATE_INVALID
printf 'KILL_SWITCH_ACTIVE=%s\n' "$kill_active"
[[ "$kill_active" == "NO" ]] || record_failure KILL_SWITCH_ACTIVE
record_check OPERATIONAL_LOCK_STATE_VALID "$lock_state_valid" OPERATIONAL_LOCK_STATE_INVALID
printf 'OVERLAP_LOCK_RESIDUAL=%s\n' "$lock_residual"
[[ "$lock_residual" == "NO" ]] || record_failure OVERLAP_LOCK_RESIDUAL
record_check RUNTIME_DISK_READINESS "$([[ "$disk_ready" == YES ]] && printf PASS || printf FAIL)" RUNTIME_DISK_READINESS_FAILED
record_check TIMER_PERSISTENT_CONTRACT "$timer_persistent_valid" TIMER_PERSISTENT_CONTRACT_MISMATCH
record_check TIMER_MODEL_CONTRACT "$timer_model_valid" TIMER_CADENCE_MISMATCH
record_check TIMER_INTERVAL_CONTRACT "$timer_interval_valid" TIMER_CADENCE_MISMATCH
record_check TIMER_TARGET_CONTRACT "$timer_target_valid" TIMER_TARGET_MISMATCH
record_check TIMER_FILE_COUNT_CONTRACT "$timer_count_valid" TIMER_FILE_COUNT_MISMATCH
printf 'AUTOMATIC_RETRY_ENABLED=%s\n' "$([[ "$automatic_retry_disabled" == YES ]] && printf NO || printf YES)"
[[ "$automatic_retry_disabled" == YES ]] || record_failure AUTOMATIC_RETRY_CONTRACT_MISMATCH
printf 'TRADING_EXECUTION_ENABLED=%s\n' "$([[ "$trading_execution_disabled" == YES ]] && printf NO || printf YES)"
[[ "$trading_execution_disabled" == YES ]] || record_failure TRADING_EXECUTION_CONTRACT_MISMATCH
printf '%s\n' "SECRET_VALUE_EXPOSURE_COUNT=0"

health_state=NOT_READY
if [[ "$service_inactive" == YES && "$service_enabled_valid" == YES ]]; then
    if [[ "$timer_enabled_state" == "disabled" &&
          "$timer_active_state" == "inactive" &&
          "$timer_next_elapse_scheduled" == "NO" &&
          "$control_enabled_state" == "disabled" &&
          "$control_active_state" == "inactive" ]]; then
        health_state=READY_NOT_ENABLED
    elif [[ "$timer_enabled_state" == "enabled" &&
            "$timer_active_state" == "active" &&
            "$timer_substate" == "waiting" &&
            "$timer_next_monotonic_finite" == "YES" &&
            "$timer_next_monotonic_in_future" == "YES" &&
            "$control_enabled_state" == "enabled" &&
            "$control_active_state" == "active" ]]; then
        health_state=READY_AND_AUTOMATION_ENABLED
    else
        [[ "$timer_enabled_state" != "enabled" || "$timer_active_state" == "active" ]] ||
            record_failure TIMER_ENABLED_BUT_NOT_ACTIVE
        [[ "$timer_active_state" != "active" || "$timer_enabled_state" == "enabled" ]] ||
            record_failure TIMER_ACTIVE_BUT_NOT_ENABLED
        if [[ "$timer_enabled_state" == "enabled" &&
              "$timer_next_elapse_scheduled" != "YES" ]]; then
            record_failure "$timer_schedule_failure_reason"
        fi
        [[ "$timer_enabled_state" != "enabled" || "$timer_substate" == "waiting" ]] ||
            record_failure TIMER_UNEXPECTED_SUBSTATE
        [[ "$timer_enabled_state" != "disabled" || "$timer_active_state" == "inactive" ]] ||
            record_failure TIMER_ACTIVE_BUT_NOT_ENABLED
        [[ "$timer_enabled_state" != "disabled" ||
           "$timer_next_elapse_scheduled" == "NO" ]] ||
            record_failure TIMER_DISABLED_WITH_NEXT_ELAPSE
        [[ "$timer_enabled_state" == "enabled" || "$timer_enabled_state" == "disabled" ]] ||
            record_failure TIMER_STATE_UNKNOWN
        [[ "$timer_active_state" == "active" || "$timer_active_state" == "inactive" ]] ||
            record_failure TIMER_STATE_UNKNOWN
    fi
fi

printf 'SERVICE_ACTIVE=%s\n' "$service_active_state"
printf 'SERVICE_ENABLED=%s\n' "$service_enabled_state"
printf 'TIMER_ACTIVE=%s\n' "$timer_active_state"
printf 'TIMER_ENABLED=%s\n' "$timer_enabled_state"
printf 'CONTROL_ACTIVE=%s\n' "$control_active_state"
printf 'CONTROL_ENABLED=%s\n' "$control_enabled_state"
printf 'TIMER_SUBSTATE=%s\n' "$timer_substate"
printf '%s\n' "CURRENT_MONOTONIC_CLOCK_SOURCE=python3_CLOCK_MONOTONIC"
printf 'CURRENT_MONOTONIC_USEC=%s\n' "${current_monotonic_usec:-UNAVAILABLE}"
printf 'NEXT_ELAPSE_MONOTONIC_USEC=%s\n' "${timer_next_monotonic_usec:-UNAVAILABLE}"
printf 'NEXT_ELAPSE_REALTIME_USEC=%s\n' "${timer_next_realtime_usec:-UNAVAILABLE}"
printf 'REMAINING_UNTIL_ELAPSE_USEC=%s\n' "${remaining_until_elapse_usec:-UNAVAILABLE}"
printf 'NEXT_ELAPSE_MONOTONIC_FINITE=%s\n' "$timer_next_monotonic_finite"
printf 'NEXT_ELAPSE_MONOTONIC_IN_FUTURE=%s\n' "$timer_next_monotonic_in_future"
printf 'TIMER_NEXT_ELAPSE_SCHEDULED=%s\n' "$timer_next_elapse_scheduled"

if [[ "$failure_count" -eq 0 && "$health_state" != "NOT_READY" ]]; then
    printf 'HEALTH_STATUS=%s\n' "$health_state"
    exit 0
fi
for reason in "${failure_reasons[@]}"; do
    printf 'HEALTH_REASON=%s\n' "$reason"
done
printf '%s\n' "HEALTH_STATUS=NOT_READY"
printf 'HEALTH_FAILURE_COUNT=%d\n' "$failure_count"
exit 1
