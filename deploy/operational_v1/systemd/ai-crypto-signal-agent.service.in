[Unit]
Description=AI Crypto Signal Agent F4 bounded operational one-shot
Wants=network-online.target
After=network-online.target
ConditionPathExists=@@RELEASE_ROOT@@/.f4-release-manifest
ConditionPathExists=/var/lib/ai-crypto-signal-agent/accepted-locked-commit.marker

[Service]
Type=oneshot
User=ai-crypto-signal-agent
Group=ai-crypto-signal-agent
WorkingDirectory=/var/lib/ai-crypto-signal-agent/phase09r1
EnvironmentFile=/etc/ai-crypto-signal-agent/phase09r1.env
EnvironmentFile=/etc/ai-crypto-signal-agent/deepseek.env
Environment=F4_RELEASE_COMMIT=@@F4_COMMIT@@
Environment=PRODUCTION_SIGNAL_DIR=/var/lib/ai-crypto-signal-agent/phase09r1/production-signals
Environment=TELEGRAM_QUOTA_STATE_PATH=/var/lib/ai-crypto-signal-agent/phase09r1/quota-slot-state/q.json
Environment=TELEGRAM_WORKER_STATE_PATH=/var/lib/ai-crypto-signal-agent/phase09r1/quota-slot-state/w.json
Environment=TELEGRAM_QUOTA_LIMIT=1
Environment=TELEGRAM_SLOT_CAPACITY=1
Environment=TELEGRAM_WINDOW_ID=f4-operational-cycle
Environment=TELEGRAM_MAX_MESSAGE_LENGTH=4000
LoadCredential=accepted_locked_commit:/var/lib/ai-crypto-signal-agent/accepted-locked-commit.marker
RuntimeDirectory=ai-crypto-signal-agent
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
ExecStart=@@RELEASE_ROOT@@/deploy/operational_v1/bin/ai-crypto-signal-agent-run-once
TimeoutStartSec=20min
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-crypto-signal-agent
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-crypto-signal-agent/phase09r1 /var/lib/ai-crypto-signal-agent/operational-artifacts /run/ai-crypto-signal-agent
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
