#!/usr/bin/env bash
set -euo pipefail

readonly TRUSTED_CHECKPOINT_COMMIT="@@TRUSTED_CHECKPOINT_COMMIT@@"
readonly ROOT_USER="root"
readonly ROOT_GROUP="root"
readonly SERVICE_GROUP="ai-crypto-signal-agent"

usage() {
    printf '%s\n' "usage: $0 --deployment-profile CANDIDATE_CANARY|PRODUCTION --release-commit COMMIT40 --target-release PATH --destdir PATH" >&2
    exit 64
}

e6_path_has_no_write_mode_bits() {
    local mode
    mode="$(stat -Lc '%a' -- "$1" 2>/dev/null)" || return 1
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#$mode & 8#222) == 0 ))
}

profile=""
release_commit=""
target_release=""
destdir=""
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --deployment-profile)
            [[ "$#" -ge 2 ]] || usage
            profile="$2"
            shift 2
            ;;
        --release-commit)
            [[ "$#" -ge 2 ]] || usage
            release_commit="$2"
            shift 2
            ;;
        --target-release)
            [[ "$#" -ge 2 ]] || usage
            target_release="$2"
            shift 2
            ;;
        --destdir)
            [[ "$#" -ge 2 ]] || usage
            destdir="$2"
            shift 2
            ;;
        *) usage ;;
    esac
done

[[ "$release_commit" =~ ^[0-9a-f]{40}$ && "$target_release" = /* && "$destdir" = /* ]] || usage
[[ -d "$destdir" && ! -L "$destdir" ]] || exit 65
case "$profile" in
    CANDIDATE_CANARY)
        control_relative="var/lib/ai-crypto-signal-agent-e6-installations/$release_commit"
        ;;
    PRODUCTION)
        control_relative="var/lib/ai-crypto-signal-agent-e6-production-control"
        ;;
    *) usage ;;
esac
control_root="$destdir/$control_relative"
[[ -d "$control_root" && ! -L "$control_root" ]] || exit 65
current_ref="$control_root/installed-release.path"
rollback_ref="$control_root/rollback-release.path"
evidence_path="$control_root/rollback-evidence.txt"

verify_release() {
    local release="$1"
    local commit
    [[ "$release" = /* && -d "$release" && ! -L "$release" ]] || return 1
    e6_path_has_no_write_mode_bits "$release" || return 1
    [[ "$(realpath -- "$release")" == "$release" ]] || return 1
    commit="$(basename -- "$release")"
    [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || return 1
    [[ -f "$release/.e6-release-manifest" && ! -L "$release/.e6-release-manifest" ]] || return 1
    [[ -f "$release/.e6-sha256-manifest" && ! -L "$release/.e6-sha256-manifest" ]] || return 1
    [[ "$(sed -n 's/^SOURCE_COMMIT=//p' "$release/.e6-release-manifest")" == "$commit" ]] || return 1
    [[ "$(sed -n 's/^SOURCE_TREE=//p' "$release/.e6-release-manifest")" =~ ^[0-9a-f]{40}$ ]] || return 1
    [[ "$(sed -n 's/^TRUSTED_CHECKPOINT_COMMIT=//p' "$release/.e6-release-manifest")" == "$TRUSTED_CHECKPOINT_COMMIT" ]] || return 1
    (cd -- "$release" && sha256sum --quiet -c .e6-sha256-manifest) || return 1
}

read_reference() {
    [[ -f "$1" && ! -L "$1" && "$(wc -l < "$1")" -eq 1 ]] || return 1
    sed -n '1p' "$1"
}

atomic_write() {
    local destination="$1"
    local content="$2"
    local owner="$3"
    local group="$4"
    local mode="$5"
    local temporary
    temporary="$(mktemp "$control_root/.e6-rollback.XXXXXXXX")"
    if ! { printf '%s\n' "$content" > "$temporary" &&
           chown "$owner:$group" "$temporary" &&
           chmod "$mode" "$temporary" &&
           mv -fT -- "$temporary" "$destination"; }; then
        unlink -- "$temporary" 2>/dev/null || true
        return 1
    fi
}

metadata_is() {
    [[ "$(stat -Lc '%U:%G:%a' "$1" 2>/dev/null || true)" == "$2:$3:$4" ]]
}

current_release="$(read_reference "$current_ref")" || exit 65
metadata_is "$current_ref" "$ROOT_USER" "$SERVICE_GROUP" 440 || exit 65
[[ "$(basename -- "$current_release")" == "$release_commit" ]] || exit 65
resolved_target="$(realpath -- "$target_release" 2>/dev/null)" || exit 65
[[ "$resolved_target" == "$target_release" ]] || exit 65
target_release="$resolved_target"

if [[ "$current_release" == "$target_release" ]]; then
    prior_release="$(read_reference "$rollback_ref")" || exit 66
    [[ -f "$evidence_path" && ! -L "$evidence_path" ]] || exit 66
    metadata_is "$rollback_ref" "$ROOT_USER" "$SERVICE_GROUP" 440 || exit 66
    metadata_is "$evidence_path" "$ROOT_USER" "$ROOT_GROUP" 400 || exit 66
    verify_release "$current_release" || exit 66
    verify_release "$prior_release" || exit 66
    printf '%s\n' "E6_ROLLBACK=IDEMPOTENT_REPLAY"
    printf '%s\n' "STATE_AUTHORITY_MUTATION=NO"
    printf '%s\n' "SERVICE_OPERATION_EXECUTED=NO"
    exit 0
fi

verify_release "$current_release" || exit 65
verify_release "$target_release" || exit 65
[[ ! -e "$rollback_ref" && ! -L "$rollback_ref" ]] || exit 66
[[ ! -e "$evidence_path" && ! -L "$evidence_path" ]] || exit 66

atomic_write "$rollback_ref" "$current_release" "$ROOT_USER" "$SERVICE_GROUP" 0440
atomic_write "$evidence_path" "DEPLOYMENT_PROFILE=$profile
BOUND_RELEASE_COMMIT=$release_commit
FROM_RELEASE=$current_release
TO_RELEASE=$target_release
TRUSTED_CHECKPOINT_COMMIT=$TRUSTED_CHECKPOINT_COMMIT
STATE_AUTHORITY_RETAINED_IN_PLACE=YES" "$ROOT_USER" "$ROOT_GROUP" 0400
atomic_write "$current_ref" "$target_release" "$ROOT_USER" "$SERVICE_GROUP" 0440

printf '%s\n' "E6_ROLLBACK=COMPLETE"
printf '%s\n' "STATE_AUTHORITY_RETAINED_IN_PLACE=YES"
printf '%s\n' "CANARY_STATE_PROMOTION_COUNT=0"
printf '%s\n' "SERVICE_OPERATION_EXECUTED=NO"
printf '%s\n' "TIMER_ENABLEMENT_OPERATION_EXECUTED=NO"
