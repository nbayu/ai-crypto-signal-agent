#!/usr/bin/env bash
set -euo pipefail

readonly TRUSTED_CHECKPOINT_COMMIT="@@TRUSTED_CHECKPOINT_COMMIT@@"
readonly PYTHON_BIN="/opt/ai-crypto-signal-agent-phase09r1/.venv/bin/python"
readonly SERVICE_USER="ai-crypto-signal-agent"
readonly SERVICE_GROUP="ai-crypto-signal-agent"
readonly BINDING_VERSION="e6-deployment-state-binding-v1"
readonly ACTIVATION_SCHEMA="e6-activation-configuration-v2"
readonly PROVIDER_BINDING_VERSION="e5-provider-model-price-binding-v4"
readonly PROVIDER_BINDING_SHA256="4a31dbcb7a0c4daed3215dbe8817002c24b2ead30e7092096c992b322e0fe1d9"
readonly EXPECTED_CONFIGURATION_KEYS=$'E6_ACTIVATION_SCHEMA_VERSION\nE6_DEPLOYMENT_BINDING_VERSION\nE6_DEPLOYMENT_PROFILE\nE6_RELEASE_COMMIT\nE6_RELEASE_TREE\nE6_TRUSTED_CHECKPOINT_COMMIT\nE6_RELEASE_ROOT\nE6_SERVICE_UNIT\nE6_TIMER_UNIT\nE6_STATE_ROOT\nE6_OWNER_STATE_ROOT\nE6_LEDGER_ROOT\nE6_ACTIVE_SIGNAL_LEDGER_PATH\nE6_OWNER_CONTROL_STATE_PATH\nE6_PUBLICATION_ROOT\nE6_OPERATIONAL_ARTIFACT_ROOT\nE6_RUNTIME_ROOT\nE6_RUNTIME_LOCK_PATH\nE6_CACHE_ROOT\nE6_LOG_POLICY\nE6_CONTROL_ROOT\nE6_RELEASE_REFERENCE_PATH\nE6_ROLLBACK_REFERENCE_PATH\nE6_ACCEPTED_RELEASE_MARKER_PATH\nE6_KILL_SWITCH_PATH\nE6_CONFIGURATION_ROOT\nE6_CREDENTIAL_METADATA_PATH\nE6_ACTIVATION_CONFIGURATION_PATH\nE6_SERVICE_USER\nE6_SERVICE_GROUP\nE6_PROVIDER_BINDING_VERSION\nE6_PROVIDER_BINDING_SHA256\nE6_RUNTIME_ENABLED\nE6_PROVIDER_ENABLED\nE6_ACTIVATION_GATE\nE6_WORKLOAD_GATE\nE6_CREDENTIAL_GATE\nE6_NETWORK_GATE\nE6_PUBLICATION_GATE\nE6_TELEGRAM_PUBLICATION_GATE\nE6_AUTOMATIC_RETRY_COUNT\nE6_PROVIDER_SUBSTITUTION_ENABLED\nE6_PROMPT_REPAIR_ENABLED\nE6_STALE_REVIEW_REUSE_ENABLED\nE6_AUTOMATED_EXCHANGE_TRADING_ENABLED'

umask 0077

fail_closed() {
    printf 'E6_LAUNCH_BLOCKED=%s\n' "$1" >&2
    exit 78
}

configuration_value() {
    sed -n "s/^$1=//p" "$configuration_path"
}

require_configuration_value() {
    [[ "$(configuration_value "$1")" == "$2" ]] || fail_closed "BINDING_${1}"
}

e6_path_has_no_write_mode_bits() {
    local path="$1"
    local mode

    mode="$(stat -Lc '%a' -- "$path" 2>/dev/null)" || return 1
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#$mode & 8#222) == 0 ))
}

script_path="$(realpath -- "$0")"
release_root="$(realpath -- "$(dirname -- "$script_path")/../../..")"
release_name="$(basename -- "$release_root")"

[[ "$release_name" =~ ^[0-9a-f]{40}$ ]] || fail_closed "RELEASE_PATH_IDENTITY"
e6_path_has_no_write_mode_bits "$release_root" || fail_closed "RELEASE_NOT_IMMUTABLE"
[[ -f "$release_root/.e6-release-manifest" && ! -L "$release_root/.e6-release-manifest" ]] ||
    fail_closed "RELEASE_MANIFEST_FILE"
[[ -f "$release_root/.e6-sha256-manifest" && ! -L "$release_root/.e6-sha256-manifest" ]] ||
    fail_closed "RELEASE_SHA256_MANIFEST_FILE"

source_commit="$(sed -n 's/^SOURCE_COMMIT=//p' "$release_root/.e6-release-manifest")"
source_tree="$(sed -n 's/^SOURCE_TREE=//p' "$release_root/.e6-release-manifest")"
release_trust="$(sed -n 's/^TRUSTED_CHECKPOINT_COMMIT=//p' "$release_root/.e6-release-manifest")"
[[ "$source_commit" == "$release_name" ]] || fail_closed "RELEASE_COMMIT_IDENTITY"
[[ "$source_tree" =~ ^[0-9a-f]{40}$ ]] || fail_closed "RELEASE_TREE_IDENTITY"
[[ "$release_trust" == "$TRUSTED_CHECKPOINT_COMMIT" ]] || fail_closed "RELEASE_TRUST_IDENTITY"
(
    cd -- "$release_root"
    sha256sum --quiet -c .e6-sha256-manifest
) || fail_closed "RELEASE_BYTE_IDENTITY"

[[ -f "$release_root/TRUSTED_E6_CHECKPOINT_COMMIT" && ! -L "$release_root/TRUSTED_E6_CHECKPOINT_COMMIT" ]] ||
    fail_closed "REPOSITORY_BINDING_FILE"
[[ "$(cat "$release_root/TRUSTED_E6_CHECKPOINT_COMMIT")" == "$TRUSTED_CHECKPOINT_COMMIT" ]] ||
    fail_closed "REPOSITORY_BINDING_BYTES"

configuration_path="${E6_ACTIVATION_CONFIGURATION_PATH:-}"
[[ "$configuration_path" = /* && -f "$configuration_path" && ! -L "$configuration_path" ]] ||
    fail_closed "ACTIVATION_CONFIGURATION_FILE"
[[ "$(stat -Lc '%U:%G:%a' "$configuration_path")" == "$SERVICE_USER:$SERVICE_GROUP:640" ]] ||
    fail_closed "ACTIVATION_CONFIGURATION_METADATA"
[[ "$(cut -d= -f1 "$configuration_path")" == "$EXPECTED_CONFIGURATION_KEYS" ]] ||
    fail_closed "ACTIVATION_CONFIGURATION_KEYS"
! LC_ALL=C grep -q $'\r' "$configuration_path" || fail_closed "ACTIVATION_CONFIGURATION_FORMAT"

deployment_profile="$(configuration_value E6_DEPLOYMENT_PROFILE)"
case "$deployment_profile" in
    CANDIDATE_CANARY)
        identity="ai-crypto-signal-agent-e6-candidate-$source_commit"
        state_root="/var/lib/$identity"
        owner_root="$state_root/owner-blueprint"
        publication_root="$state_root/publication-evidence"
        operational_root="$state_root/operational-artifacts"
        runtime_root="/run/$identity"
        cache_root="/var/cache/$identity"
        control_root="/var/lib/ai-crypto-signal-agent-e6-installations/$source_commit"
        configuration_root="/etc/ai-crypto-signal-agent/e6-candidates/$source_commit"
        service_unit="$identity.service"
        timer_unit="$identity.timer"
        ;;
    PRODUCTION)
        identity="ai-crypto-signal-agent-e6-production"
        state_root="/var/lib/ai-crypto-signal-agent/phase09r1"
        owner_root="$state_root/owner-blueprint"
        publication_root="$state_root/production-signals"
        operational_root="/var/lib/ai-crypto-signal-agent/operational-artifacts"
        runtime_root="/run/$identity"
        cache_root="/var/cache/$identity"
        control_root="/var/lib/ai-crypto-signal-agent-e6-production-control"
        configuration_root="/etc/ai-crypto-signal-agent/e6-production"
        service_unit="$identity.service"
        timer_unit="$identity.timer"
        ;;
    *) fail_closed "DEPLOYMENT_PROFILE" ;;
esac

active_ledger="$owner_root/active-signal-ledger-v2.json"
owner_state="$owner_root/telegram-owner-control-state-v1.json"
runtime_lock="$runtime_root/e6-operational.lock"
install_pointer="$control_root/installed-release.path"
rollback_pointer="$control_root/rollback-release.path"
accepted_marker="$control_root/accepted-release.marker"
kill_switch="$control_root/kill-switch.active"
activation_configuration="$configuration_root/activation-v1.env"
credential_metadata="$configuration_root/credentials.metadata"

require_configuration_value E6_ACTIVATION_SCHEMA_VERSION "$ACTIVATION_SCHEMA"
require_configuration_value E6_DEPLOYMENT_BINDING_VERSION "$BINDING_VERSION"
require_configuration_value E6_DEPLOYMENT_PROFILE "$deployment_profile"
require_configuration_value E6_RELEASE_COMMIT "$source_commit"
require_configuration_value E6_RELEASE_TREE "$source_tree"
require_configuration_value E6_TRUSTED_CHECKPOINT_COMMIT "$TRUSTED_CHECKPOINT_COMMIT"
require_configuration_value E6_RELEASE_ROOT "$release_root"
require_configuration_value E6_SERVICE_UNIT "$service_unit"
require_configuration_value E6_TIMER_UNIT "$timer_unit"
require_configuration_value E6_STATE_ROOT "$state_root"
require_configuration_value E6_OWNER_STATE_ROOT "$owner_root"
require_configuration_value E6_LEDGER_ROOT "$owner_root"
require_configuration_value E6_ACTIVE_SIGNAL_LEDGER_PATH "$active_ledger"
require_configuration_value E6_OWNER_CONTROL_STATE_PATH "$owner_state"
require_configuration_value E6_PUBLICATION_ROOT "$publication_root"
require_configuration_value E6_OPERATIONAL_ARTIFACT_ROOT "$operational_root"
require_configuration_value E6_RUNTIME_ROOT "$runtime_root"
require_configuration_value E6_RUNTIME_LOCK_PATH "$runtime_lock"
require_configuration_value E6_CACHE_ROOT "$cache_root"
require_configuration_value E6_LOG_POLICY "NONE_JOURNALD_ONLY"
require_configuration_value E6_CONTROL_ROOT "$control_root"
require_configuration_value E6_RELEASE_REFERENCE_PATH "$install_pointer"
require_configuration_value E6_ROLLBACK_REFERENCE_PATH "$rollback_pointer"
require_configuration_value E6_ACCEPTED_RELEASE_MARKER_PATH "$accepted_marker"
require_configuration_value E6_KILL_SWITCH_PATH "$kill_switch"
require_configuration_value E6_CONFIGURATION_ROOT "$configuration_root"
require_configuration_value E6_CREDENTIAL_METADATA_PATH "$credential_metadata"
require_configuration_value E6_ACTIVATION_CONFIGURATION_PATH "$activation_configuration"
require_configuration_value E6_SERVICE_USER "$SERVICE_USER"
require_configuration_value E6_SERVICE_GROUP "$SERVICE_GROUP"
require_configuration_value E6_PROVIDER_BINDING_VERSION "$PROVIDER_BINDING_VERSION"
require_configuration_value E6_PROVIDER_BINDING_SHA256 "$PROVIDER_BINDING_SHA256"
require_configuration_value E6_RUNTIME_ENABLED true
require_configuration_value E6_PROVIDER_ENABLED true
require_configuration_value E6_ACTIVATION_GATE true
require_configuration_value E6_WORKLOAD_GATE true
require_configuration_value E6_CREDENTIAL_GATE true
require_configuration_value E6_NETWORK_GATE true
require_configuration_value E6_PUBLICATION_GATE true
require_configuration_value E6_TELEGRAM_PUBLICATION_GATE true
require_configuration_value E6_AUTOMATIC_RETRY_COUNT 0
require_configuration_value E6_PROVIDER_SUBSTITUTION_ENABLED false
require_configuration_value E6_PROMPT_REPAIR_ENABLED false
require_configuration_value E6_STALE_REVIEW_REUSE_ENABLED false
require_configuration_value E6_AUTOMATED_EXCHANGE_TRADING_ENABLED false

[[ "$configuration_path" == "$activation_configuration" ]] || fail_closed "ACTIVATION_CONFIGURATION_BINDING"
[[ "${ACTIVE_SIGNAL_LEDGER_PATH:-}" == "$active_ledger" ]] || fail_closed "ACTIVE_LEDGER_BINDING"
[[ "${TELEGRAM_OWNER_CONTROL_STATE_PATH:-}" == "$owner_state" ]] || fail_closed "OWNER_STATE_BINDING"
[[ -f "$install_pointer" && ! -L "$install_pointer" && "$(cat "$install_pointer")" == "$release_root" ]] ||
    fail_closed "ACTIVATION_RELEASE_REFERENCE"
[[ -f "$credential_metadata" && ! -L "$credential_metadata" &&
   "$(stat -Lc '%U:%G:%a' "$credential_metadata")" == "$SERVICE_USER:$SERVICE_GROUP:640" ]] ||
    fail_closed "CREDENTIAL_METADATA_INVALID"
[[ -f "$owner_state" && ! -L "$owner_state" &&
   "$(stat -Lc '%U:%G:%a' "$owner_state")" == "$SERVICE_USER:$SERVICE_GROUP:600" ]] ||
    fail_closed "OWNER_CONTROL_METADATA_INVALID"
[[ -f "$active_ledger" && ! -L "$active_ledger" &&
   "$(stat -Lc '%U:%G:%a' "$active_ledger")" == "$SERVICE_USER:$SERVICE_GROUP:600" ]] ||
    fail_closed "ACTIVE_LEDGER_METADATA_INVALID"
[[ -f "$accepted_marker" && ! -L "$accepted_marker" &&
   "$(stat -Lc '%U:%G:%a' "$accepted_marker")" == "root:root:400" &&
   "$(cat "$accepted_marker")" == "$source_commit" ]] || fail_closed "ACCEPTED_MARKER_INVALID"

if [[ -e "$kill_switch" || -L "$kill_switch" ]]; then
    [[ -f "$kill_switch" && ! -L "$kill_switch" && -r "$kill_switch" ]] || fail_closed "KILL_SWITCH_STATE"
    printf '%s\n' "E6_LAUNCH_BLOCKED=KILL_SWITCH_ACTIVE" >&2
    exit 75
fi

[[ -d "$runtime_root" && ! -L "$runtime_root" &&
   "$(stat -Lc '%U:%G:%a' "$runtime_root")" == "$SERVICE_USER:$SERVICE_GROUP:750" ]] ||
    fail_closed "LOCK_DIRECTORY_IDENTITY"
if [[ -e "$runtime_lock" || -L "$runtime_lock" ]]; then
    [[ -f "$runtime_lock" && ! -L "$runtime_lock" &&
       "$(stat -Lc '%U:%G:%a' "$runtime_lock")" == "$SERVICE_USER:$SERVICE_GROUP:600" ]] ||
        fail_closed "LOCK_FILE_IDENTITY"
fi
if ! { exec 9>"$runtime_lock"; } 2>/dev/null; then
    fail_closed "LOCK_PERMISSION"
fi
[[ -f "$runtime_lock" && ! -L "$runtime_lock" &&
   "$(stat -Lc '%U:%G:%a' "$runtime_lock")" == "$SERVICE_USER:$SERVICE_GROUP:600" ]] ||
    fail_closed "LOCK_FILE_IDENTITY"
flock -n 9 || {
    printf '%s\n' "E6_LAUNCH_BLOCKED=OVERLAP_LOCK_HELD" >&2
    exit 75
}

cleanup_lock() {
    unlink -- "$runtime_lock"
}
trap cleanup_lock EXIT

export PYTHONPATH="$release_root"
/usr/bin/timeout --signal=TERM --kill-after=30s 20m \
    "$PYTHON_BIN" -m engine.run_production_signal_v1
