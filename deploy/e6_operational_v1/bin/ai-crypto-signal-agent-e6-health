#!/usr/bin/env bash
set -euo pipefail

readonly TRUSTED_CHECKPOINT_COMMIT="@@TRUSTED_CHECKPOINT_COMMIT@@"
readonly SERVICE_USER="ai-crypto-signal-agent"
readonly SERVICE_GROUP="ai-crypto-signal-agent"
readonly ROOT_USER="root"
readonly ROOT_GROUP="root"
readonly LEGACY_TIMER_NAME="ai-crypto-signal-agent.timer"
readonly TELEGRAM_ENVIRONMENT="/etc/ai-crypto-signal-agent/phase09r1.env"
readonly PROVIDER_ENVIRONMENT="/etc/ai-crypto-signal-agent/deepseek.env"

usage() {
    printf '%s\n' "usage: $0 --deployment-profile CANDIDATE_CANARY|PRODUCTION --release-commit COMMIT40" >&2
    exit 64
}

profile=""
release_commit=""
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --deployment-profile)
            [[ "$#" -ge 2 ]] || usage
            profile="$2"
            shift 2
            ;;
        --release-commit)
            [[ "$#" -ge 2 ]] || usage
            release_commit="$2"
            shift 2
            ;;
        *) usage ;;
    esac
done
[[ "$release_commit" =~ ^[0-9a-f]{40}$ ]] || usage

case "$profile" in
    CANDIDATE_CANARY)
        identity="ai-crypto-signal-agent-e6-candidate-$release_commit"
        state_root="/var/lib/$identity"
        owner_root="$state_root/owner-blueprint"
        publication_root="$state_root/publication-evidence"
        operational_root="$state_root/operational-artifacts"
        runtime_root="/run/$identity"
        cache_root="/var/cache/$identity"
        control_root="/var/lib/ai-crypto-signal-agent-e6-installations/$release_commit"
        configuration_root="/etc/ai-crypto-signal-agent/e6-candidates/$release_commit"
        ;;
    PRODUCTION)
        identity="ai-crypto-signal-agent-e6-production"
        state_root="/var/lib/ai-crypto-signal-agent/phase09r1"
        owner_root="$state_root/owner-blueprint"
        publication_root="$state_root/production-signals"
        operational_root="/var/lib/ai-crypto-signal-agent/operational-artifacts"
        runtime_root="/run/$identity"
        cache_root="/var/cache/$identity"
        control_root="/var/lib/ai-crypto-signal-agent-e6-production-control"
        configuration_root="/etc/ai-crypto-signal-agent/e6-production"
        ;;
    *) usage ;;
esac

service_unit="$identity.service"
timer_unit="$identity.timer"
service_path="/etc/systemd/system/$service_unit"
timer_path="/etc/systemd/system/$timer_unit"
active_ledger="$owner_root/active-signal-ledger-v2.json"
owner_state="$owner_root/telegram-owner-control-state-v1.json"
runtime_lock="$runtime_root/e6-operational.lock"
release_ref="$control_root/installed-release.path"
rollback_ref="$control_root/rollback-release.path"
accepted_marker="$control_root/accepted-release.marker"
kill_switch="$control_root/kill-switch.active"
activation_configuration="$configuration_root/activation-v1.env"
credential_metadata="$configuration_root/credentials.metadata"

failure_count=0
declare -a failure_reasons=()

record_check() {
    local key="$1"
    local result="$2"
    local reason="$3"
    printf '%s=%s\n' "$key" "$result"
    if [[ "$result" != YES && "$result" != PASS ]]; then
        failure_reasons+=("$reason")
        failure_count=$((failure_count + 1))
    fi
}

configuration_value() {
    sed -n "s/^$1=//p" "$activation_configuration"
}

metadata_is() {
    [[ -e "$1" && ! -L "$1" && "$(stat -Lc '%U:%G:%a' "$1" 2>/dev/null || true)" == "$2:$3:$4" ]]
}

e6_path_has_no_write_mode_bits() {
    local mode
    mode="$(stat -Lc '%a' -- "$1" 2>/dev/null)" || return 1
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#$mode & 8#222) == 0 ))
}

release_root=""
release_match=NO
release_bytes_match=NO
if metadata_is "$release_ref" "$ROOT_USER" "$SERVICE_GROUP" 440 && [[ "$(wc -l < "$release_ref")" -eq 1 ]]; then
    release_root="$(sed -n '1p' "$release_ref")"
fi
if [[ "$release_root" == "/opt/ai-crypto-signal-agent-releases/$release_commit" &&
      -d "$release_root" && ! -L "$release_root" &&
      -f "$release_root/.e6-release-manifest" &&
      "$(sed -n 's/^SOURCE_COMMIT=//p' "$release_root/.e6-release-manifest")" == "$release_commit" &&
      "$(sed -n 's/^TRUSTED_CHECKPOINT_COMMIT=//p' "$release_root/.e6-release-manifest")" == "$TRUSTED_CHECKPOINT_COMMIT" ]] &&
   e6_path_has_no_write_mode_bits "$release_root"; then
    release_match=YES
    if (cd -- "$release_root" && sha256sum --quiet -c .e6-sha256-manifest); then
        release_bytes_match=YES
    fi
fi

activation_binding_valid=NO
if metadata_is "$configuration_root" "$ROOT_USER" "$SERVICE_GROUP" 750 &&
   metadata_is "$activation_configuration" "$SERVICE_USER" "$SERVICE_GROUP" 640 &&
   metadata_is "$credential_metadata" "$SERVICE_USER" "$SERVICE_GROUP" 640 &&
   [[ "$(configuration_value E6_ACTIVATION_SCHEMA_VERSION)" == "e6-activation-configuration-v2" &&
      "$(configuration_value E6_DEPLOYMENT_BINDING_VERSION)" == "e6-deployment-state-binding-v1" &&
      "$(configuration_value E6_DEPLOYMENT_PROFILE)" == "$profile" &&
      "$(configuration_value E6_RELEASE_COMMIT)" == "$release_commit" &&
      "$(configuration_value E6_RELEASE_ROOT)" == "$release_root" &&
      "$(configuration_value E6_SERVICE_UNIT)" == "$service_unit" &&
      "$(configuration_value E6_TIMER_UNIT)" == "$timer_unit" &&
      "$(configuration_value E6_STATE_ROOT)" == "$state_root" &&
      "$(configuration_value E6_OWNER_STATE_ROOT)" == "$owner_root" &&
      "$(configuration_value E6_ACTIVE_SIGNAL_LEDGER_PATH)" == "$active_ledger" &&
      "$(configuration_value E6_OWNER_CONTROL_STATE_PATH)" == "$owner_state" &&
      "$(configuration_value E6_PUBLICATION_ROOT)" == "$publication_root" &&
      "$(configuration_value E6_OPERATIONAL_ARTIFACT_ROOT)" == "$operational_root" &&
      "$(configuration_value E6_RUNTIME_ROOT)" == "$runtime_root" &&
      "$(configuration_value E6_RUNTIME_LOCK_PATH)" == "$runtime_lock" &&
      "$(configuration_value E6_CACHE_ROOT)" == "$cache_root" &&
      "$(configuration_value E6_CONTROL_ROOT)" == "$control_root" &&
      "$(configuration_value E6_RELEASE_REFERENCE_PATH)" == "$release_ref" &&
      "$(configuration_value E6_ROLLBACK_REFERENCE_PATH)" == "$rollback_ref" &&
      "$(configuration_value E6_ACCEPTED_RELEASE_MARKER_PATH)" == "$accepted_marker" &&
      "$(configuration_value E6_KILL_SWITCH_PATH)" == "$kill_switch" &&
      "$(configuration_value E6_CONFIGURATION_ROOT)" == "$configuration_root" &&
      "$(configuration_value E6_CREDENTIAL_METADATA_PATH)" == "$credential_metadata" &&
      "$(configuration_value E6_ACTIVATION_CONFIGURATION_PATH)" == "$activation_configuration" ]]; then
    activation_binding_valid=YES
fi

service_match=NO
timer_match=NO
if [[ -n "$release_root" && -f "$service_path" && ! -L "$service_path" &&
      -f "$release_root/.e6-rendered/$service_unit" &&
      "$(sha256sum "$service_path" | awk '{print $1}')" == "$(sha256sum "$release_root/.e6-rendered/$service_unit" | awk '{print $1}')" ]]; then
    service_match=YES
fi
if [[ -n "$release_root" && -f "$timer_path" && ! -L "$timer_path" &&
      -f "$release_root/.e6-rendered/$timer_unit" &&
      "$(sha256sum "$timer_path" | awk '{print $1}')" == "$(sha256sum "$release_root/.e6-rendered/$timer_unit" | awk '{print $1}')" &&
      "$(sed -n 's/^Unit=//p' "$timer_path")" == "$service_unit" &&
      "$(sed -n 's/^OnCalendar=//p' "$timer_path")" == "*-*-* *:*:00 UTC" &&
      "$(sed -n 's/^AccuracySec=//p' "$timer_path")" == "1s" &&
      "$(sed -n 's/^Persistent=//p' "$timer_path")" == false ]]; then
    timer_match=YES
fi

candidate_state_valid=YES
if [[ "$profile" == CANDIDATE_CANARY ]]; then
    candidate_state_valid=NO
    if metadata_is "$state_root" "$SERVICE_USER" "$SERVICE_GROUP" 750 &&
       metadata_is "$owner_root" "$SERVICE_USER" "$SERVICE_GROUP" 700 &&
       metadata_is "$publication_root" "$SERVICE_USER" "$SERVICE_GROUP" 700 &&
       metadata_is "$operational_root" "$SERVICE_USER" "$SERVICE_GROUP" 700 &&
       metadata_is "$cache_root" "$SERVICE_USER" "$SERVICE_GROUP" 700 &&
       metadata_is "$owner_state" "$SERVICE_USER" "$SERVICE_GROUP" 600 &&
       metadata_is "$active_ledger" "$SERVICE_USER" "$SERVICE_GROUP" 600 &&
       grep -q '"schema_name":"telegram-owner-control-state"' "$owner_state" &&
       grep -q '"schema_version":1' "$owner_state" &&
       grep -q '"revision":0' "$owner_state" &&
       grep -q '"processed_updates":{}' "$owner_state" &&
       grep -q '"processed_commands":{}' "$owner_state" &&
       grep -q '"signal_message_bindings":{}' "$owner_state" &&
       grep -q '"schema_name":"active-signal-ledger"' "$active_ledger" &&
       grep -q '"schema_version":2' "$active_ledger" &&
       grep -q '"ledger_revision":0' "$active_ledger" &&
       grep -q '"signals":{}' "$active_ledger" &&
       grep -q '"transitions":{}' "$active_ledger" &&
       grep -q '"publication_transactions":{}' "$active_ledger"; then
        candidate_state_valid=YES
    fi
fi

marker_valid=NO
if metadata_is "$accepted_marker" "$ROOT_USER" "$ROOT_GROUP" 400 &&
   [[ "$(cat "$accepted_marker")" == "$release_commit" ]]; then
    marker_valid=YES
fi
secret_metadata_valid=NO
if metadata_is "$TELEGRAM_ENVIRONMENT" "$ROOT_USER" "$ROOT_GROUP" 600 &&
   metadata_is "$PROVIDER_ENVIRONMENT" "$ROOT_USER" "$ROOT_GROUP" 600; then
    secret_metadata_valid=YES
fi
kill_switch_valid=YES
[[ ! -e "$kill_switch" && ! -L "$kill_switch" ]] || kill_switch_valid=NO
lock_valid=YES
if [[ -e "$runtime_lock" || -L "$runtime_lock" ]]; then
    if ! metadata_is "$runtime_lock" "$SERVICE_USER" "$SERVICE_GROUP" 600 ||
       ! { exec 8<"$runtime_lock"; } 2>/dev/null || ! flock -n 8; then
        lock_valid=NO
    fi
fi

service_active="$(systemctl is-active "$service_unit" 2>/dev/null || true)"
service_enabled="$(systemctl is-enabled "$service_unit" 2>/dev/null || true)"
timer_active="$(systemctl is-active "$timer_unit" 2>/dev/null || true)"
timer_enabled="$(systemctl is-enabled "$timer_unit" 2>/dev/null || true)"
legacy_active="$(systemctl is-active "$LEGACY_TIMER_NAME" 2>/dev/null || true)"
legacy_enabled="$(systemctl is-enabled "$LEGACY_TIMER_NAME" 2>/dev/null || true)"
legacy_substate="$(systemctl show "$LEGACY_TIMER_NAME" -p SubState --value 2>/dev/null || true)"
disabled_inactive=NO
if [[ "$service_active" == inactive && ( "$service_enabled" == disabled || "$service_enabled" == static ) &&
      "$timer_active" == inactive && "$timer_enabled" == disabled ]]; then
    disabled_inactive=YES
fi
legacy_authority=NO
if [[ "$legacy_active" == active && "$legacy_enabled" == enabled && "$legacy_substate" == waiting ]]; then
    legacy_authority=YES
fi

record_check IMMUTABLE_RELEASE_MATCH "$release_match" RELEASE_IDENTITY_MISMATCH
record_check RELEASE_BYTE_IDENTITY "$release_bytes_match" RELEASE_BYTE_IDENTITY_MISMATCH
record_check ACTIVATION_BINDING_VALID "$activation_binding_valid" ACTIVATION_BINDING_INVALID
record_check SERVICE_UNIT_MATCH "$service_match" SERVICE_UNIT_IDENTITY_MISMATCH
record_check TIMER_UNIT_MATCH "$timer_match" TIMER_UNIT_IDENTITY_MISMATCH
record_check CANDIDATE_STATE_VALID_EMPTY "$candidate_state_valid" CANDIDATE_STATE_INVALID
record_check ACCEPTED_RELEASE_MARKER_VALID "$marker_valid" ACCEPTED_RELEASE_MARKER_INVALID
record_check SECRET_ENVIRONMENT_METADATA_VALID "$secret_metadata_valid" SECRET_ENVIRONMENT_METADATA_INVALID
record_check KILL_SWITCH_INACTIVE "$kill_switch_valid" KILL_SWITCH_ACTIVE_OR_INVALID
record_check OPERATIONAL_LOCK_ABSENT_OR_UNHELD "$lock_valid" OPERATIONAL_LOCK_HELD_OR_INVALID
record_check PROFILE_UNITS_DISABLED_INACTIVE "$disabled_inactive" PROFILE_UNIT_AUTHORITY_INVALID
record_check LEGACY_PRODUCTION_AUTHORITY "$legacy_authority" LEGACY_PRODUCTION_AUTHORITY_INVALID
printf '%s\n' "SECRET_VALUE_EXPOSURE_COUNT=0"
printf '%s\n' "SERVICE_CYCLE_INVOCATION_COUNT=0"
printf '%s\n' "PROVIDER_ATTEMPT_COUNT=0"
printf '%s\n' "TELEGRAM_ATTEMPT_COUNT=0"
printf '%s\n' "AUTOMATIC_RETRY_COUNT=0"

if [[ "$failure_count" -eq 0 ]]; then
    printf '%s\n' "HEALTH_STATUS=PASS_DISABLED_NOT_ACTIVATED"
    exit 0
fi
for reason in "${failure_reasons[@]}"; do
    printf 'HEALTH_REASON=%s\n' "$reason"
done
printf '%s\n' "HEALTH_STATUS=NOT_READY"
printf 'HEALTH_FAILURE_COUNT=%d\n' "$failure_count"
exit 1
