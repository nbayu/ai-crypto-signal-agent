[Unit]
Description=AI Crypto Signal Agent E6 production one-shot
Wants=network-online.target
After=network-online.target
ConditionPathExists=@@RELEASE_ROOT@@/.e6-release-manifest
ConditionPathExists=/var/lib/ai-crypto-signal-agent-e6-production-control/accepted-release.marker
ConditionPathExists=/etc/ai-crypto-signal-agent/e6-production/activation-v1.env

[Service]
Type=oneshot
User=ai-crypto-signal-agent
Group=ai-crypto-signal-agent
WorkingDirectory=/var/lib/ai-crypto-signal-agent/phase09r1
EnvironmentFile=/etc/ai-crypto-signal-agent/e6-production/activation-v1.env
EnvironmentFile=/etc/ai-crypto-signal-agent/phase09r1.env
EnvironmentFile=/etc/ai-crypto-signal-agent/deepseek.env
Environment=E6_ACTIVATION_CONFIGURATION_PATH=/etc/ai-crypto-signal-agent/e6-production/activation-v1.env
Environment=E6_SOURCE_COMMIT=@@E6_SOURCE_COMMIT@@
Environment=E6_SOURCE_TREE=@@E6_SOURCE_TREE@@
Environment=E6_TRUSTED_CHECKPOINT_COMMIT=@@TRUSTED_CHECKPOINT_COMMIT@@
Environment=E6_CREDENTIAL_METADATA_PATH=/etc/ai-crypto-signal-agent/e6-production/credentials.metadata
Environment=ACTIVE_SIGNAL_LEDGER_PATH=/var/lib/ai-crypto-signal-agent/phase09r1/owner-blueprint/active-signal-ledger-v2.json
Environment=TELEGRAM_OWNER_CONTROL_STATE_PATH=/var/lib/ai-crypto-signal-agent/phase09r1/owner-blueprint/telegram-owner-control-state-v1.json
LoadCredential=accepted_e6_release_commit:/var/lib/ai-crypto-signal-agent-e6-production-control/accepted-release.marker
RuntimeDirectory=ai-crypto-signal-agent-e6-production
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
CacheDirectory=ai-crypto-signal-agent-e6-production
CacheDirectoryMode=0700
ExecStart=@@RELEASE_ROOT@@/deploy/e6_operational_v1/bin/ai-crypto-signal-agent-e6-run-once
TimeoutStartSec=20min
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-crypto-signal-agent-e6-production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-crypto-signal-agent/phase09r1 /var/lib/ai-crypto-signal-agent/operational-artifacts /run/ai-crypto-signal-agent-e6-production /var/cache/ai-crypto-signal-agent-e6-production
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
