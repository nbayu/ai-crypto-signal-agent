//@version=6
indicator(
    "AI Agent Scanner Fibonacci",
    shorttitle="AI Fib",
    overlay=true,
    max_boxes_count=50,
    max_lines_count=100,
    max_labels_count=50
)

// Visual scope:
// Golden Zone Fibonacci only.
//
// Architecture:
// - Python remains the scanner source of truth.
// - Pine Script mirrors the active Golden Zone logic.
// - No FVG, SMC, or Supply & Demand rendering.


// -----------------------------------------------------------------------------
// SCANNER ARTIFACT BRIDGE DECODER
// Python scanner remains the source of truth.
// -----------------------------------------------------------------------------

scannerPayload = input.text_area(
    "",
    "Scanner Payload",
    group="Scanner Bridge"
)

var bool scannerSetupFound = false
var string scannerSymbol = ""
var string scannerDirection = ""
var int scannerLowTime = na
var int scannerHighTime = na
var float scannerLow = na
var float scannerHigh = na
var float scannerFib0 = na
var float scannerFib05 = na
var float scannerFib0618 = na
var float scannerFib0786 = na
var float scannerFib1 = na
var float scannerTp = na

scannerSetupFound := false
scannerSymbol := ""
scannerDirection := ""
scannerLowTime := na
scannerHighTime := na
scannerLow := na
scannerHigh := na
scannerFib0 := na
scannerFib05 := na
scannerFib0618 := na
scannerFib0786 := na
scannerFib1 := na
scannerTp := na

records = str.split(scannerPayload, "~")

if array.size(records) > 0
    for recordIndex = 0 to array.size(records) - 1
        record = array.get(records, recordIndex)
        fields = str.split(record, "|")

        if array.size(fields) == 13
            chartSymbol = array.get(fields, 1)

            if chartSymbol == ticker.standard(syminfo.tickerid)
                scannerSetupFound := true
                scannerSymbol := array.get(fields, 0)
                scannerDirection := array.get(fields, 2)
                scannerLowTime := timestamp(
                    array.get(fields, 3)
                )
                scannerHighTime := timestamp(
                    array.get(fields, 4)
                )
                scannerLow := str.tonumber(
                    array.get(fields, 5)
                )
                scannerHigh := str.tonumber(
                    array.get(fields, 6)
                )
                scannerFib0 := str.tonumber(
                    array.get(fields, 7)
                )
                scannerFib05 := str.tonumber(
                    array.get(fields, 8)
                )
                scannerFib0618 := str.tonumber(
                    array.get(fields, 9)
                )
                scannerFib0786 := str.tonumber(
                    array.get(fields, 10)
                )
                scannerFib1 := str.tonumber(
                    array.get(fields, 11)
                )
                scannerTp := str.tonumber(
                    array.get(fields, 12)
                )

                break

// -----------------------------------------------------------------------------
// GOLDEN ZONE SETTINGS
// -----------------------------------------------------------------------------

showGoldenZone = input.bool(
    true,
    "Show Golden Zone",
    group="Golden Zone"
)

// -----------------------------------------------------------------------------
// GOLDEN ZONE VISUAL
// Scanner artifact values are the rendering source of truth.
// -----------------------------------------------------------------------------

validFib = (
    showGoldenZone
    and scannerSetupFound
    and scannerDirection != ""
    and not na(scannerLowTime)
    and not na(scannerHighTime)
    and not na(scannerLow)
    and not na(scannerHigh)
    and not na(scannerFib0)
    and not na(scannerFib05)
    and not na(scannerFib0618)
    and not na(scannerFib0786)
    and not na(scannerFib1)
    and not na(scannerTp)
)

scannerEntryLow = math.min(
    scannerFib0618,
    scannerFib0786
)

scannerEntryHigh = math.max(
    scannerFib0618,
    scannerFib0786
)

var box goldenZoneBox = na
var line fibAnchorLine = na
var line fibZeroLine = na
var line fibMidLine = na
var line fibOneLine = na
var line fibTpLine = na
var label fibDirectionLabel = na

if barstate.islast
    if not na(goldenZoneBox)
        box.delete(goldenZoneBox)

    if not na(fibAnchorLine)
        line.delete(fibAnchorLine)

    if not na(fibZeroLine)
        line.delete(fibZeroLine)

    if not na(fibMidLine)
        line.delete(fibMidLine)

    if not na(fibOneLine)
        line.delete(fibOneLine)

    if not na(fibTpLine)
        line.delete(fibTpLine)

    if not na(fibDirectionLabel)
        label.delete(fibDirectionLabel)

    if validFib
        zoneLeftTime = math.min(
            scannerLowTime,
            scannerHighTime
        )

        visualRightTime = time + (
            20 * timeframe.in_seconds() * 1000
        )

        goldenZoneBox := box.new(
            left=zoneLeftTime,
            top=scannerEntryHigh,
            right=visualRightTime,
            bottom=scannerEntryLow,
            xloc=xloc.bar_time,
            border_color=color.new(color.orange, 0),
            bgcolor=color.new(color.orange, 82),
            force_overlay=true
        )

        fibAnchorLine := line.new(
            x1=scannerLowTime,
            y1=scannerLow,
            x2=scannerHighTime,
            y2=scannerHigh,
            xloc=xloc.bar_time,
            color=color.new(color.white, 20),
            width=2,
            force_overlay=true
        )

        fibZeroLine := line.new(
            x1=zoneLeftTime,
            y1=scannerFib0,
            x2=visualRightTime,
            y2=scannerFib0,
            xloc=xloc.bar_time,
            color=color.new(color.gray, 35),
            style=line.style_dotted,
            force_overlay=true
        )

        fibMidLine := line.new(
            x1=zoneLeftTime,
            y1=scannerFib05,
            x2=visualRightTime,
            y2=scannerFib05,
            xloc=xloc.bar_time,
            color=color.new(color.yellow, 20),
            style=line.style_dotted,
            force_overlay=true
        )

        fibOneLine := line.new(
            x1=zoneLeftTime,
            y1=scannerFib1,
            x2=visualRightTime,
            y2=scannerFib1,
            xloc=xloc.bar_time,
            color=color.new(color.red, 10),
            style=line.style_dashed,
            force_overlay=true
        )

        fibTpLine := line.new(
            x1=zoneLeftTime,
            y1=scannerTp,
            x2=visualRightTime,
            y2=scannerTp,
            xloc=xloc.bar_time,
            color=color.new(color.green, 10),
            style=line.style_dashed,
            force_overlay=true
        )

        fibDirectionLabel := label.new(
            x=visualRightTime,
            y=scannerEntryHigh,
            text=scannerDirection + " GZ",
            xloc=xloc.bar_time,
            yloc=yloc.price,
            style=label.style_label_left,
            textcolor=color.white,
            color=color.new(color.orange, 20),
            size=size.small,
            force_overlay=true
        )
